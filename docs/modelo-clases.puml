@startuml Sistema_Gestion_Tutorias

skinparam classAttributeIconSize 0
skinparam backgroundColor #FFFFFF
skinparam class {
    BackgroundColor #F7F8FA
    BorderColor     #5A5A5A
    ArrowColor      #3b82d4
}
skinparam package {
    BackgroundColor #FAFAFA
    BorderColor     #AAAAAA
}

' ════════════════════════════════════════════════════════
' ENUMERACIONES
' ════════════════════════════════════════════════════════

enum EstadoReserva {
    PENDIENTE
    CONFIRMADA
    CANCELADA
    REALIZADA
}

enum Modalidad {
    PRESENCIAL
    VIRTUAL
}

' ════════════════════════════════════════════════════════
' PAQUETE: domain
' ════════════════════════════════════════════════════════

package "edu.uees.tutorias.domain" {

    abstract class Usuario {
        - id     : Long
        - nombre : String
        - email  : String
        + getId()     : Long
        + getNombre() : String
        + getEmail()  : String
    }

    class Estudiante {
        + {static} SIN_DATO : String = "-"
        - matricula     : String
        - celular       : String
        - deviceId      : String
        - cuentaTeams   : String
        - userWhatsapp  : String
        - reservas      : List<Reserva>
        + registrarReserva(reserva: Reserva) : void
        + consultarReservas()                : List<Reserva>
        + getMatricula()    : String
        + getCelular()      : String
        + getDeviceId()     : String
        + getCuentaTeams()  : String
        + getUserWhatsapp() : String
    }

    class EstudianteBuilder {
        - id            : Long
        - nombre        : String
        - email         : String
        - matricula     : String
        - celular       : String = "-"
        - deviceId      : String = "-"
        - cuentaTeams   : String = "-"
        - userWhatsapp  : String = "-"
        + id(id: Long)                       : EstudianteBuilder
        + nombre(nombre: String)             : EstudianteBuilder
        + email(email: String)               : EstudianteBuilder
        + matricula(matricula: String)       : EstudianteBuilder
        + celular(celular: String)           : EstudianteBuilder
        + deviceId(deviceId: String)         : EstudianteBuilder
        + cuentaTeams(cuentaTeams: String)   : EstudianteBuilder
        + userWhatsapp(userWhatsapp: String) : EstudianteBuilder
        + build()                            : Estudiante
    }

    class Docente {
        - departamento : String
        - horarios     : List<HorarioTutoria>
        + publicarHorario(horario: HorarioTutoria) : void
        + consultarHorarios()                      : List<HorarioTutoria>
        + getDepartamento()                        : String
    }

    Usuario <|-- Estudiante
    Usuario <|-- Docente
    EstudianteBuilder ..> Estudiante : construye >

    class Asignatura {
        - id     : Long
        - nombre : String
        - codigo : String
        + getId()     : Long
        + getNombre() : String
        + getCodigo() : String
    }

    class HorarioTutoria {
        - id              : Long
        - inicio          : LocalDateTime
        - fin             : LocalDateTime
        - disponible      : boolean
        - modalidad       : Modalidad
        - capacidadMaxima : int
        - ubicacion       : String
        + estaDisponible()    : boolean
        + reservar()          : void
        + liberar()           : void
        + getId()             : Long
        + getInicio()         : LocalDateTime
        + getFin()            : LocalDateTime
        + getAsignatura()     : Asignatura
        + getModalidad()      : Modalidad
        + getCapacidadMaxima(): int
        + getUbicacion()      : String
    }

    class HorarioTutoriaBuilder {
        - id              : Long
        - inicio          : LocalDateTime
        - fin             : LocalDateTime
        - asignatura      : Asignatura
        - modalidad       : Modalidad = VIRTUAL
        - capacidadMaxima : int = 1
        - ubicacion       : String = ""
        + id(id: Long)                       : HorarioTutoriaBuilder
        + inicio(inicio: LocalDateTime)      : HorarioTutoriaBuilder
        + fin(fin: LocalDateTime)            : HorarioTutoriaBuilder
        + asignatura(a: Asignatura)          : HorarioTutoriaBuilder
        + modalidad(m: Modalidad)            : HorarioTutoriaBuilder
        + capacidadMaxima(cap: int)          : HorarioTutoriaBuilder
        + ubicacion(ubicacion: String)       : HorarioTutoriaBuilder
        + build()                            : HorarioTutoria
    }

    class Reserva {
        - id            : Long
        - estado        : EstadoReserva
        - fechaCreacion : LocalDateTime
        + confirmar()                               : void
        + cancelar()                                : void
        + reprogramar(nuevoHorario: HorarioTutoria) : void
        + marcarRealizada()                         : void
        + getId()            : Long
        + getEstudiante()    : Estudiante
        + getHorario()       : HorarioTutoria
        + getEstado()        : EstadoReserva
        + getFechaCreacion() : LocalDateTime
    }

    ' Relaciones dentro del dominio
    HorarioTutoria     -->       Modalidad        : usa >
    HorarioTutoria     -->       Asignatura       : corresponde a >
    HorarioTutoriaBuilder ..>    HorarioTutoria   : construye >
    Docente     "1"    --  "0..*" HorarioTutoria  : publica >
    Reserva     "0..*" --> "1"    HorarioTutoria  : ocupa >
    Reserva     -->              EstadoReserva    : usa >
    Estudiante  "1"    --  "0..*" Reserva         : realiza >
}

' ════════════════════════════════════════════════════════
' PAQUETE: notification
' ════════════════════════════════════════════════════════

package "edu.uees.tutorias.notification" {

    interface Notificador {
        + enviar(destinatario: String, mensaje: String) : void
    }

    ' ── ConcreteProducts ───────────────────────────────
    class NotificadorEmail {
        + enviar(destinatario: String, mensaje: String) : void
    }
    class NotificadorSms {
        + enviar(destinatario: String, mensaje: String) : void
    }
    class NotificadorPush {
        + enviar(destinatario: String, mensaje: String) : void
    }
    class NotificadorTeams {
        + enviar(destinatario: String, mensaje: String) : void
    }
    class NotificadorWhatsapp {
        + enviar(destinatario: String, mensaje: String) : void
    }

    Notificador <|.. NotificadorEmail    : implementa
    Notificador <|.. NotificadorSms      : implementa
    Notificador <|.. NotificadorPush     : implementa
    Notificador <|.. NotificadorTeams    : implementa
    Notificador <|.. NotificadorWhatsapp : implementa

    ' ── Creator abstracto (Factory Method) ─────────────
    abstract class NotificadorCreator {
        # crearNotificador()                              : Notificador
        + obtenerDestinatario(estudiante: Estudiante)     : String
        + notificar(estudiante: Estudiante, mensaje: String) : void
    }

    ' ── ConcreteCreators ───────────────────────────────
    class EmailCreator {
        # crearNotificador()                          : Notificador
        + obtenerDestinatario(e: Estudiante)          : String
    }
    class SmsCreator {
        # crearNotificador()                          : Notificador
        + obtenerDestinatario(e: Estudiante)          : String
    }
    class PushCreator {
        # crearNotificador()                          : Notificador
        + obtenerDestinatario(e: Estudiante)          : String
    }
    class TeamsCreator {
        # crearNotificador()                          : Notificador
        + obtenerDestinatario(e: Estudiante)          : String
    }
    class WhatsappCreator {
        # crearNotificador()                          : Notificador
        + obtenerDestinatario(e: Estudiante)          : String
    }

    NotificadorCreator <|-- EmailCreator
    NotificadorCreator <|-- SmsCreator
    NotificadorCreator <|-- PushCreator
    NotificadorCreator <|-- TeamsCreator
    NotificadorCreator <|-- WhatsappCreator

    EmailCreator    ..> NotificadorEmail    : crea >
    SmsCreator      ..> NotificadorSms      : crea >
    PushCreator     ..> NotificadorPush     : crea >
    TeamsCreator    ..> NotificadorTeams    : crea >
    WhatsappCreator ..> NotificadorWhatsapp : crea >
}

' ════════════════════════════════════════════════════════
' PAQUETE: service
' ════════════════════════════════════════════════════════

package "edu.uees.tutorias.service" {

    interface RepositorioReservas {
        + guardar(reserva: Reserva)   : void
        + buscarPorId(id: Long)       : Reserva
    }

    class RepositorioReservasEnMemoria {
        - almacen : Map<Long, Reserva>
        + guardar(reserva: Reserva)   : void
        + buscarPorId(id: Long)       : Reserva
    }

    class ServicioReservas {
        + crearReserva(estudiante: Estudiante, horario: HorarioTutoria)      : Reserva
        + confirmarReserva(reservaId: Long)                                  : void
        + cancelarReserva(reservaId: Long)                                   : void
        + reprogramarReserva(reservaId: Long, nuevoHorario: HorarioTutoria) : void
    }

    RepositorioReservas  <|..  RepositorioReservasEnMemoria  : implementa
    ServicioReservas     -->   RepositorioReservas            : persiste via >
    ServicioReservas     -->   Notificador                    : notifica via (legado) >
    ServicioReservas     o-->  NotificadorCreator             : notifica via (multi-canal) >
    ServicioReservas     ..>   Reserva                        : crea >
}

@enduml
